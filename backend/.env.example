# Supabase project settings (Settings -> API in the Supabase dashboard)
SUPABASE_URL=supabase_url
SUPABASE_ANON_KEY=supabase_anon_key

# Settings -> API -> JWT Settings -> JWT Secret
# Used server-side ONLY to verify incoming access tokens. Never expose this to the frontend.
SUPABASE_JWT_SECRET=supabase_jwt_secret

# Settings -> API -> Project API keys -> service_role (click "Reveal")
# Bypasses Row Level Security. Backend-only, NEVER expose this to the frontend or commit a
# real value. Used only by the public /reports/{id}/public and /reports/{id}/qrcode endpoints.
SUPABASE_SERVICE_ROLE_KEY=supabase_service_role_key

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5500

# Canonical frontend origin — the QR code on each report encodes {FRONTEND_URL}/verify/{id}
FRONTEND_URL=http://localhost:5173